{
  "name": "plhoa-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:deploy:dry": "npm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply penny-lane-hoa --local",
    "db:migrate:remote": "wrangler d1 migrations apply penny-lane-hoa --remote"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  }
}
